# No secrets are required to run this site — it is fully static.
# Copy to .env.local only if you add one of the optional integrations below.

# Public site URL, used for canonical tags, sitemap and OG metadata.
# Vercel sets this automatically in production; set it locally only if you care
# about absolute URLs while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: privacy-friendly analytics to see whether recruiters open the site.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lakshgupta.is-a.dev
