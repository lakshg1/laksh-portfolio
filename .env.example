# No secrets are required to run this site — it is fully static.
# Copy to .env.local only if you add one of the optional integrations below.

# Public site URL, used for canonical tags, sitemap and OG metadata.
# Vercel sets this automatically in production; set it locally only if you care
# about absolute URLs while developing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: privacy-friendly analytics to see whether recruiters open the site.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=lakshgupta.is-a.dev

# ---------------------------------------------------------------------------
# Cover-letter studio (private tooling). Set these in .env.local and, if you
# deploy, in your Vercel project's Environment Variables.
# ---------------------------------------------------------------------------

# Required to unlock the admin tooling. Pick something strong.
ADMIN_PASSWORD=change-me
# Optional separate signing key for the session cookie (defaults to ADMIN_PASSWORD).
# ADMIN_SECRET=some-long-random-string

# Storage (libSQL / SQLite).
#   Local dev  : leave unset — a file at ./data/portfolio.db is used.
#   Production : create a free Turso db and paste its URL + token here so writes
#                persist on Vercel's read-only filesystem.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# LLM endpoint (OpenAI-compatible). Local Ollama works out of the box.
#   Local  : http://localhost:11434/v1  (run `ollama serve` + `ollama pull qwen3`)
#   Prod   : expose your Ollama via a tunnel, or point at any OpenAI-compatible API.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3
# OPENAI_API_KEY=   # only needed if your endpoint requires a bearer token
